---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageCta from '../components/PageCta.astro';
import AppStoreLink from '../components/AppStoreLink.astro';
import { siteUrl } from '../data/site';

const {
  title,
  description,
  canonicalPath,
  h1,
  intro,
  breadcrumbLabel,
  ctaHeading,
  ctaBody,
  extraStructuredData = []
} = Astro.props;

// Optional product screenshot beside the h1, passed as slot="hero-media".
const hasHeroMedia = Astro.slots.has('hero-media');

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: breadcrumbLabel, path: canonicalPath }
];

// One SoftwareApplication node lives on the homepage. Deeper pages reference it
// rather than redeclaring the app, so the graph stays consistent.
const structuredData = [
  {
    '@type': 'WebPage',
    '@id': `${new URL(canonicalPath, siteUrl).toString()}#about`,
    about: { '@id': `${siteUrl}#app` }
  },
  ...extraStructuredData
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  page="landing"
  ogTitle={title}
  ogDescription={description}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <main id="main-content" tabindex="-1">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="landing-hero">
      <div class:list={['container', hasHeroMedia && 'landing-hero-grid']}>
        <div class="landing-hero-copy">
          <h1>{h1}</h1>
          <p class="lead">{intro}</p>
          <p class="landing-hero-actions">
            <AppStoreLink />
            <a class="quiet-link" href="/screenshots/">See inside the app</a>
          </p>
          <p class="microcopy">iPhone, iPad &amp; Mac · Review current purchase options and feature availability in the app.</p>
        </div>
        {hasHeroMedia && <slot name="hero-media" />}
      </div>
    </section>

    <div class="container landing-body">
      <slot />
      <aside class="publisher-note" aria-label="Publisher information">
        <strong>Published by the Quiet Tools Support Team</strong>
        <span>Colorado, United States · <a href="/about/">About the team</a> · <a href="/editorial-standards/">Editorial standards</a></span>
      </aside>
    </div>

    <PageCta heading={ctaHeading} body={ctaBody} />
  </main>
</BaseLayout>
