---
import LandingLayout from '../layouts/LandingLayout.astro';
import ProductBlock from '../components/ProductBlock.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { page } from '../data/site';
const related = [page('/home-maintenance-records/'), page('/home-contractor-records/'), page('/appliance-maintenance-records/'), page('/home-handoff-report/')];
---
<LandingLayout title="Home Repair Cost Tracker and Maintenance Expense Log" description="Track home repair and maintenance costs with the item, date, provider, work performed, notes, photos, receipt, and invoice behind each expense." canonicalPath="/home-repair-cost-tracker/" breadcrumbLabel="Home repair cost tracker" h1="A home repair cost tracker with the story behind every expense" intro="A total tells you how much you spent. A useful home record also tells you which item needed work, what was repaired, who handled it, and whether the same problem keeps returning." ctaHeading="Record the last meaningful home expense." ctaBody="Add the amount, date, item, provider, and one sentence about the work. Attach the invoice if you have it.">
  <section><h2>What to record with a repair cost</h2><ul class="qa-list"><li><strong>Item</strong><span>The appliance, system, room, or exterior component that received the work.</span></li><li><strong>Work</strong><span>Repair, replacement, maintenance, inspection, or improvement.</span></li><li><strong>Provider</strong><span>The company or person who performed it.</span></li><li><strong>Evidence</strong><span>Estimate, invoice, receipt, warranty claim, and before-and-after photos.</span></li><li><strong>Outcome</strong><span>What changed, parts used, and any follow-up recommendation.</span></li></ul></section>
  <ProductBlock device="ipad" src="/assets/screenshots/new/ipad-cost-tracking.webp" alt="Home repair and maintenance cost tracking report in Around The House on iPad"><h2>See spending across the home</h2><p>Cost reports summarize recorded maintenance and repair spending while preserving the entries behind the totals. Review costs by property and time period without reducing the home to a bare spreadsheet.</p></ProductBlock>
  <ProductBlock device="iphone" flip src="/assets/screenshots/new/iphone-item-history.webp" alt="Home item repair history with dates, providers, notes, and costs on iPhone"><h2>Spot repeat repairs and aging equipment</h2><p>Costs become more useful when they appear in date order on an item's history. You can see whether an appliance has needed repeated service and bring the full context to the next repair-or-replace decision.</p></ProductBlock>
  <section><h2>Keep estimates separate from completed costs</h2><p>Record what was actually paid after the work is complete, then attach the final invoice. Add enough detail to explain unusual totals, bundled work, rebates, insurance payments, or a warranty-covered repair.</p></section>
  <RelatedLinks heading="Connect costs to the home record" items={related} />
</LandingLayout>
