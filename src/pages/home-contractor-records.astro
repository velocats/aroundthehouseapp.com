---
import LandingLayout from '../layouts/LandingLayout.astro';
import ProductBlock from '../components/ProductBlock.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { page } from '../data/site';
const related = [page('/home-maintenance-records/'), page('/home-repair-cost-tracker/'), page('/digital-home-binder/'), page('/resources/home-maintenance-records-to-keep/')];
---
<LandingLayout title="Home Contractor and Service Records App | Around the House" description="Keep contractor and home service records with completed work, affected items, dates, costs, notes, invoices, photos, and contact details." canonicalPath="/home-contractor-records/" breadcrumbLabel="Contractor records" h1="Contractor records connected to the work they performed" intro="A contact name alone rarely answers the question you have later. Keep the provider beside the repair, maintenance entry, affected item, cost, and invoice that explain the relationship." ctaHeading="Add the provider you would hire again." ctaBody="Connect the provider to a completed job and record what made the experience worth remembering.">
  <section><h2>Build a useful service-provider record</h2><ul class="qa-list"><li><strong>Contact</strong><span>Company, person, phone, email, and relevant trade.</span></li><li><strong>Completed work</strong><span>The date, scope, affected home item, and outcome.</span></li><li><strong>Cost</strong><span>Final amount with estimate, receipt, or invoice.</span></li><li><strong>Details</strong><span>Parts, paint colors, materials, settings, and follow-up recommendations.</span></li><li><strong>Qualification notes</strong><span>License, insurance, warranty, or permit details when relevant and independently verified.</span></li></ul></section>
  <ProductBlock device="iphone" src="/assets/screenshots/new/iphone-item-history.webp" alt="Home maintenance history on iPhone showing completed contractor work and costs"><h2>Remember the provider in context</h2><p>The furnace history can show who serviced it last time and what they did. The roof record can retain the inspection report and invoice. This makes the next call easier than searching a contact list for a vaguely familiar name.</p></ProductBlock>
  <section><h2>What to document after a contractor visit</h2><p>Record the actual completion date, work performed, findings, parts and materials, total cost, warranty terms, recommended follow-up, and the next due date. Attach the signed proposal, permit or inspection record, final invoice, and useful photos.</p><p>Do not treat a private note as proof of licensing or insurance. Verify current credentials with the appropriate issuing authority when the next job requires them.</p></section>
  <RelatedLinks heading="Preserve the full service history" items={related} />
</LandingLayout>
