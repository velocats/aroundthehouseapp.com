---
import BaseLayout from '../layouts/BaseLayout.astro';
import { appStoreUrl, siteUrl } from '../data/site';
const appDescription = 'Around The House is a private home maintenance app for organizing home records, repairs, reminders, insurance coverage, personal property, receipts, photos, and important documents.';
const values = [
  ['⌁', 'What happened', 'Repairs, maintenance, projects and service history.', '/home-maintenance-records/'],
  ['▤', 'What you own', 'Appliances, equipment, valuables, warranties and documents.', '/digital-home-binder/'],
  ['□', "What’s next", 'Recurring maintenance, expiration dates and upcoming work.', '/home-maintenance-reminders/']
];
const benefits = [
  ['⌂', 'Maintain', 'Stay ahead of problems.', "Get reminders for routine maintenance and important dates, so small issues don’t become big ones.", '/home-maintenance-tracker/'],
  ['▥', 'Understand', 'See what you own.', "Document personal property and the appliances and systems that make up the home.", '/home-inventory-app/'],
  ['▤', 'Remember', 'Find it when you need it.', 'Receipts, warranties, manuals and photos, right where you expect them.', '/digital-home-binder/']
];
const faqItems = [
  ['What is Around The House?', 'Around The House is a home maintenance app that keeps home, maintenance, project, insurance, and personal-property records and documents organized in one private Binder.'],
  ['Does Around The House require an account?', 'No. Around The House does not require a separate web account. Your records stay on your Apple devices and in your private iCloud account when iCloud sync is enabled.']
];
const structuredData = [{ '@type': 'SoftwareApplication', '@id': `${siteUrl}#app`, name: 'Around The House', url: siteUrl, applicationCategory: 'LifestyleApplication', operatingSystem: 'iOS, iPadOS, macOS', description: appDescription, image: `${siteUrl}assets/og/around-the-house-og-v2.png`, publisher: { '@id': `${siteUrl}#organization` }, offers: [{ '@type': 'Offer', price: '0.99', priceCurrency: 'USD', url: appStoreUrl }] }, { '@type': 'FAQPage', mainEntity: faqItems.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) }];
---
<BaseLayout title="Around The House: Home Maintenance App" description="Organize home maintenance, personal property, insurance coverage, receipts, photos, warranties, and important house records in one private app." structuredData={structuredData}>
  <main id="main-content" tabindex="-1" class="home-page">
    <section class="editorial-hero"><div class="container editorial-hero-grid">
      <div class="editorial-hero-copy"><div class="kicker">A Quiet Tools app</div><h1>Your home<br />has a history.<br />Keep it.</h1><p class="hero-lead">Repairs, maintenance, warranties, receipts, costs and reminders, all in one private place.</p><div class="hero-actions"><a href={appStoreUrl} target="_blank" rel="noopener"><img class="app-store-badge" src="/assets/app-store-badge.svg" width="170" height="57" alt="Download on the App Store" /></a><a class="text-action" href="#features">See how it works <span aria-hidden="true">→</span></a></div></div>
      <div class="device-stage" aria-label="Around The House shown on iPhone and iPad"><div class="device device-ipad"><img src="/assets/screenshots/new/ipad-front-page.webp" width="1200" height="1600" alt="Around The House home maintenance report on iPad" fetchpriority="high" decoding="async" /></div><div class="device device-iphone"><img src="/assets/screenshots/new/iphone-items.webp" width="1206" height="2622" alt="Around The House home items on iPhone" decoding="async" /></div><p class="hand-note">A more organized home<br />for whatever’s next.</p></div>
    </div></section>
    <section class="memory-section" id="features"><div class="container"><div class="kicker">Everything your home forgets</div><h2>Everything you’ll wish<br />you remembered later.</h2><div class="value-columns">{values.map(([symbol, title, body, href]) => <article><span class="line-icon" aria-hidden="true">{symbol}</span><div><h3><a href={href}>{title}</a></h3><p>{body}</p></div></article>)}</div></div></section>
    <section class="forest-showcase"><div class="container forest-grid"><div class="forest-copy"><div class="kicker">A complete picture</div><h2>See your home<br />in one place.</h2><p>From the big systems to the small stuff, Around The House helps you keep track of what you have, what it’s cost, who worked on it, and what’s next.</p><a class="light-button" href="/screenshots/">Explore the features</a></div><div class="feature-device"><img src="/assets/screenshots/new/ipad-schedule.webp" alt="Around The House maintenance schedule on iPad" loading="lazy" /></div></div></section>
    <section class="benefit-section"><div class="container benefit-columns">{benefits.map(([symbol, label, title, body, href]) => <article><span class="line-icon" aria-hidden="true">{symbol}</span><div class="kicker">{label}</div><h3><a href={href}>{title}</a></h3><p>{body}</p></article>)}</div></section>
    <section class="privacy-strip"><div class="container privacy-grid"><span class="privacy-lock" aria-hidden="true">⌑</span><div><div class="kicker">Your data, yours</div><h2>Private by design.</h2></div><div><p>Your home information stays on your devices and in your control. No ads. No tracking. Just a simple tool for homeowners.</p><a href="/privacy/">Learn more about privacy →</a></div></div></section>
    <section class="story-section"><div class="container story-grid"><div class="story-visual phone-duo"><img src="/assets/screenshots/new/iphone-warranty-countdown.webp" alt="Warranty countdown in Around The House" loading="lazy" /><img src="/assets/screenshots/new/iphone-cost-tracking.webp" alt="Home cost tracking in Around The House" loading="lazy" /></div><div class="story-copy"><div class="kicker">Know what matters</div><h2>Details you can find when life asks for them.</h2><p>Keep warranties, receipts, maintenance history and costs connected to the things they belong to—not scattered through drawers, inboxes and photo libraries.</p><a class="text-action" href="/digital-home-binder/">Explore the digital home binder <span aria-hidden="true">→</span></a></div></div></section>
    <section class="final-cta"><div class="container final-cta-grid"><div class="final-product-shot"><img src="/assets/screenshots/new/ipad-home-handoff.webp" width="2048" height="2732" alt="Around The House home handoff report on iPad" loading="lazy" /></div><div><div class="kicker">A more organized tomorrow</div><h2>A home well kept<br />is a home well lived.</h2><p>Download Around The House and start building your home’s history today.</p><a href={appStoreUrl} target="_blank" rel="noopener"><img class="app-store-badge" src="/assets/app-store-badge.svg" width="170" height="57" alt="Download on the App Store" /></a></div></div></section>
  </main>
</BaseLayout>
