---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreLink from '../components/AppStoreLink.astro';
import HomeStoryHero from '../components/HomeStoryHero.astro';
import HomeHealthCheckTeaser from '../components/HomeHealthCheckTeaser.astro';
import '../styles/home-story.css';
import { siteUrl } from '../data/site';
const description = 'The details you need, the work you’ve done, and what’s coming next. Keep your home records at your fingertips with Around The House for iPhone, iPad, and Mac.';
const structuredData = {
  '@type': 'SoftwareApplication', '@id': `${siteUrl}#app`, name: 'Around The House', url: siteUrl,
  applicationCategory: 'LifestyleApplication', operatingSystem: 'iOS, iPadOS, macOS', description,
  image: `${siteUrl}assets/og/around-the-house-og-v2.png`, publisher: { '@id': `${siteUrl}#organization` }
  // Live purchase configuration is not verified. No pricing/trial Offer claims.
};
---
<BaseLayout title="Home Records at Your Fingertips | Around The House" description={description} structuredData={structuredData}>
  <main id="main-content" tabindex="-1" class="home-story-page">
    <HomeStoryHero />
    <HomeHealthCheckTeaser />
    <section class="story-how" id="how-it-works" aria-labelledby="story-how-title">
      <div class="story-content-width">
        <div class="story-how-heading"><p class="story-eyebrow">A little less to remember</p><h2 id="story-how-title">The answer belongs<br />with the item.</h2><p>A filter size. The paint you used. The plumber who fixed it. Keep the details with your home, ready for the next time you need them.</p></div>
        <ol class="story-steps">
          <li><span aria-hidden="true">01</span><div><h3>Save it while it’s handy.</h3><p>A label photo, a paint color, a receipt. Give the things you want to remember a place.</p><a href="/home-records-app/">See what you can save <span aria-hidden="true">↗</span></a></div></li>
          <li><span aria-hidden="true">02</span><div><h3>Find it when you need it.</h3><p>At the store or under the sink, open the record instead of hunting through old photos and messages.</p><a href="/digital-home-binder/">Keep the paperwork together <span aria-hidden="true">↗</span></a></div></li>
          <li><span aria-hidden="true">03</span><div><h3>Remember what’s next.</h3><p>Keep the work you’ve done and the reminders you’ve set connected to the same item.</p><a href="/home-maintenance-reminders/">A reminder for the next time <span aria-hidden="true">↗</span></a></div></li>
        </ol>
      </div>
    </section>
    <section class="story-close" aria-labelledby="story-close-title">
      <div class="story-content-width story-close-inner"><div><p class="story-eyebrow">Your home. Your information.</p><h2 id="story-close-title">Keep a little history<br />close at hand.</h2><p>No separate Around The House account. Your records stay on your Apple devices and, when enabled, sync through your private iCloud.</p><AppStoreLink /></div><nav class="story-useful-links" aria-label="More for your home"><a href="/paint-color-tracker/">Remember the paint color <span aria-hidden="true">↗</span></a><a href="/annual-home-maintenance-checklist/">Plan the next bit of upkeep <span aria-hidden="true">↗</span></a><a href="/resources/">Read the homeowner guides <span aria-hidden="true">↗</span></a><a href="/privacy/">Read about privacy <span aria-hidden="true">↗</span></a></nav></div>
    </section>
  </main>
</BaseLayout>
