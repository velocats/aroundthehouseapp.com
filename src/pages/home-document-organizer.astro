---
import LandingLayout from '../layouts/LandingLayout.astro';
import ProductBlock from '../components/ProductBlock.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { page } from '../data/site';
const related = [page('/digital-home-binder/'), page('/home-warranty-tracker/'), page('/appliance-maintenance-records/'), page('/resources/how-to-create-a-digital-home-binder/')];
---
<LandingLayout title="Home Document Organizer for Manuals, Receipts, and Warranties" description="Organize home manuals, receipts, warranties, invoices, photos, and service documents with the appliance, system, or property each file belongs to." canonicalPath="/home-document-organizer/" breadcrumbLabel="Home document organizer" h1="A home document organizer built around the things you own" intro="A folder named Receipts still makes you search. Around The House files a receipt, manual, warranty, invoice, or photo with the home item it describes, beside that item's identifying details and history." ctaHeading="File one document where you would look for it later." ctaBody="Choose an important appliance, add its model and serial number, then attach its manual, receipt, or warranty.">
  <section><h2>Documents worth keeping</h2><ul class="qa-list"><li><strong>Purchase</strong><span>Receipts, order confirmations, install dates, and vendor details.</span></li><li><strong>Operation</strong><span>Owner manuals, model references, settings, and care instructions.</span></li><li><strong>Coverage</strong><span>Warranty terms, protection plans, claim details, and expiration dates.</span></li><li><strong>Service</strong><span>Estimates, invoices, inspection reports, permits, and parts information.</span></li><li><strong>Condition</strong><span>Photos, labels, serial numbers, and before-and-after evidence.</span></li></ul></section>
  <ProductBlock device="ipad" src="/assets/screenshots/new/ipad-binder.webp" alt="Digital home binder on iPad with organized household documents"><h2>Browse the binder or open the item</h2><p>The binder gives documents a home-wide view. Item records provide the other direction: start with the dishwasher, roof, or water heater and find the files that explain it.</p></ProductBlock>
  <ProductBlock device="ipad" flip src="/assets/screenshots/new/ipad-item-record.webp" alt="Home item record with details, documents, maintenance, and photos"><h2>Keep facts and files together</h2><p>A document is easier to use when the model, serial number, installation date, warranty countdown, photos, and repair history are nearby. That context also makes a home handoff more understandable.</p></ProductBlock>
  <section><h2>Use stable names and preserve originals</h2><p>Name files with the item and date when possible. Keep original invoices and warranty documents, avoid storing unnecessary sensitive information, and retain another appropriate backup or source copy for records whose loss would matter.</p></section>
  <RelatedLinks heading="Create a dependable home filing system" items={related} />
</LandingLayout>
