---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreLink from '../components/AppStoreLink.astro';
import { siteUrl } from '../data/site';
const pricingSchema = {
  '@type': 'WebPage', '@id': `${siteUrl}pricing/#pricing`, about: { '@id': `${siteUrl}#app` }
};
---
<BaseLayout title="Around The House Pricing & Download" description="Download Around The House for iPhone, iPad, and Mac. Review current pricing, purchase options, and feature availability on the App Store and in the app." canonicalPath="/pricing/" page="pricing" structuredData={pricingSchema}>
  <main id="main-content" tabindex="-1">
    <section class="pricing-hero"><div class="container pricing-hero-grid"><div><p class="kicker">Around The House</p><h1>Start small.<br />Keep adding.</h1></div><div><p>Save a paint color, an appliance label, or the details of a recent repair and build from there. Around The House is available for iPhone, iPad, and Mac.</p><AppStoreLink /></div></div></section>
    <section class="pricing-page-section"><div class="container">
      <div class="free-plan"><div><p class="kicker">Pricing &amp; availability</p><h2>Review the current options.</h2></div><div><p>The App Store listing and the purchase screen in Around The House show current prices, available features, and purchase terms for your region. Review those details before choosing a purchase.</p><p>You can also <a href="/screenshots/">see the app screens</a> or <a href="/home-health-check/">take the free Home Health Check</a> here, without an account.</p></div></div>
    </div></section>
    <section class="pricing-details"><div class="container pricing-detail-grid"><div><p class="kicker">A record of your home</p><h2>All the details.<br />One place to look.</h2><a class="light-button" href="/home-records-app/">Explore what you can save</a></div><ul><li>Paint colors, finishes, and photos</li><li>Appliances, filter sizes, and installation dates</li><li>Repair history and trusted service providers</li><li>Projects and home improvements</li><li>Maintenance schedules and reminders</li><li>Private iCloud sync across your Apple devices</li></ul></div></section>
  </main>
</BaseLayout>

<style>
  .pricing-page-section { padding-block:40px; }
  .free-plan { padding-bottom:0; }
  .free-plan p + p { margin-top:18px; }
</style>
