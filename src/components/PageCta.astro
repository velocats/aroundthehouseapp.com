---
import AppStoreLink from './AppStoreLink.astro';
const {
  heading = 'Your home has a history. Keep it.',
  body = 'Around The House is available on the App Store for iPhone, iPad, and Mac.'
} = Astro.props;
---
<section class="page-cta">
  <div class="container">
    <h2>{heading}</h2>
    <p>{body}</p>
    <p class="page-cta-actions">
      <AppStoreLink />
    </p>
    <p class="microcopy">iPhone, iPad &amp; Mac · Explore an example home. Review current purchase options in the app.</p>
    <p class="microcopy">No separate Around The House account. Private iCloud sync across your own devices when enabled.</p>
  </div>
</section>
