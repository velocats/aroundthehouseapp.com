---
import { appStoreUrl } from '../data/site';
const { label = 'Download on the App Store' } = Astro.props;
---
<a class="store-link" href={appStoreUrl} target="_blank" rel="noopener" aria-label={label}>
  <img class="app-store-badge" src="/assets/app-store-badge.svg" width="170" height="57" alt="Download on the App Store" />
</a>
