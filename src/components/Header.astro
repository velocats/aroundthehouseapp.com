---
const { page = 'home' } = Astro.props;
const isHome = page === 'home';
const appStoreUrl = 'https://apps.apple.com/us/app/around-the-house-binder/id6789646793';
const prefix = isHome ? '' : '/';

const links = [
  ['Features', `${prefix}#features`],
  ['Screenshots', '/screenshots/'],
  ['Pricing', `${prefix}#pricing`],
  ['Support', '/support/']
];
---
<header class="site-header">
  <nav class="container nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Around The House home">
      <img src="/assets/icons/around-the-house-icon.png" width="512" height="512" alt="Around The House app icon" />
      <span>Around The House</span>
    </a>
    <div class="nav-links desktop-links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="nav-cta" href={appStoreUrl} target="_blank" rel="noopener">Download</a>
    </div>
    <details class="nav-disclosure">
      <summary aria-label="Open menu">Menu</summary>
      <div class="nav-disclosure-panel">
        {links.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="nav-cta" href={appStoreUrl} target="_blank" rel="noopener">Download</a>
      </div>
    </details>
  </nav>
</header>
