---
const isHome = Astro.url.pathname === '/';
import { appStoreUrl } from '../data/site';
const prefix = isHome ? '' : '/';

const links = [
  ['What you can save', '/home-records-app/'],
  ['How it works', `${prefix}#how-it-works`],
  ['Guides', '/resources/'],
  ['Screenshots', '/screenshots/'],
  ['Pricing', '/pricing/'],
  ['Support', '/support/']
];
---
<header class="site-header">
  <nav class="container nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Around The House home">
      <img class="brand-mark" src="/assets/icons/around-the-house-icon.png" width="512" height="512" alt="" />
      <span>Around The House</span>
    </a>
    <div class="nav-links desktop-links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="nav-download" href={appStoreUrl} target="_blank" rel="noopener">Download Free</a>
    </div>
    <a class="nav-download mobile-download" href={appStoreUrl} target="_blank" rel="noopener">Download Free</a>
    <details class="nav-disclosure">
      <summary aria-label="Open menu">Menu</summary>
      <div class="nav-disclosure-panel">
        {links.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </details>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-disclosure');
  menu?.addEventListener('click', event => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
