---
const isHome = Astro.url.pathname === '/';
import AppStoreLink from './AppStoreLink.astro';
const prefix = isHome ? '' : '/';
const current = (href: string) => (href === Astro.url.pathname ? 'page' : undefined);

const links = [
  ['What you can save', '/home-records-app/'],
  ['How it works', `${prefix}#how-it-works`],
  ['Guides', '/resources/'],
  ['Blog', '/blog/'],
  ['Screenshots', '/screenshots/'],
  ['Pricing', '/pricing/'],
  ['Support', '/support/']
];
---
<header class="site-header">
  <nav class="container nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Around The House home">
      <img class="brand-mark" src="/assets/icons/around-the-house-icon.png" width="512" height="512" alt="" />
      <span>Around The House</span>
    </a>
    <div class="nav-links desktop-links">
      {links.map(([label, href]) => <a href={href} aria-current={current(href)}>{label}</a>)}
      <AppStoreLink compact />
    </div>
    <AppStoreLink compact className="mobile-download" />
    <details class="nav-disclosure">
      <summary>Menu</summary>
      <div class="nav-disclosure-panel">
        {links.map(([label, href]) => <a href={href} aria-current={current(href)}>{label}</a>)}
      </div>
    </details>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-disclosure');
  menu?.addEventListener('click', event => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  // An open panel must not stay over the page once focus or attention moves on.
  menu?.addEventListener('focusout', event => {
    if (event.relatedTarget && !menu.contains(event.relatedTarget as Node)) menu.open = false;
  });
  document.addEventListener('click', event => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>
