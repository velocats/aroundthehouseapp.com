---
import { appStoreUrl, supportEmail } from '../data/site';
const { compact = false } = Astro.props;
---
<footer class="footer">
  {compact ? (
    <div class="container">
      <p>© 2026 Around The House. Built by <a href="https://quiettoolsapps.com/">Quiet Tools</a></p>
    </div>
  ) : (
    <div class="container footer-grid">
      <div>
        <a class="brand" href="/">
          <img class="brand-mark" src="/assets/icons/around-the-house-icon.png" width="512" height="512" alt="" />
          <span>Around The House</span>
        </a>
        <p>The home memory app for repairs, reminders, warranties, receipts, photos, notes, and important home details.</p>
      </div>
      <div>
        <h4>Product</h4>
        <a href="/home-maintenance-app/">Home maintenance app</a>
        <a href="/home-maintenance-tracker/">Maintenance tracker</a>
        <a href="/home-maintenance-records/">Maintenance records</a>
        <a href="/home-maintenance-reminders/">Maintenance reminders</a>
        <a href="/digital-home-binder/">Digital home binder</a>
        <a href="/home-inventory-app/">Home inventory</a>
        <a href="/new-homeowner-app/">For new homeowners</a>
        <a href="/home-warranty-tracker/">Warranty tracker</a>
        <a href="/home-handoff-report/">Home handoff report</a>
        <a href="/homezada-alternative/">Compare with HomeZada</a>
        <a href="/screenshots/">App screenshots</a>
        <a href="/pricing/">Pricing</a>
        <a href={appStoreUrl} target="_blank" rel="noopener">Download on the App Store</a>
      </div>
      <div>
        <h4>Support</h4>
        <a href="/support/">Support</a>
        <a href="/resources/">Homeowner guides</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="https://quiettoolsapps.com/">Quiet Tools</a>
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
        <p>© 2026 Around The House.</p>
      </div>
    </div>
  )}
</footer>
