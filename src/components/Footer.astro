---
import { supportEmail } from '../data/site';
import AppStoreLink from './AppStoreLink.astro';
const { compact = false } = Astro.props;
const records = [
  ['/home-records-app/', 'What you can save'],
  ['/paint-color-tracker/', 'Paint colors & finishes'],
  ['/appliance-maintenance-records/', 'Appliance records'],
  ['/digital-home-binder/', 'Digital home binder'],
  ['/home-document-organizer/', 'Documents & manuals'],
  ['/home-contractor-records/', 'Contractor records'],
  ['/home-inventory-app/', 'Home inventory'],
  ['/new-homeowner-app/', 'For new homeowners'],
  ['/home-handoff-report/', 'Home handoff report']
];
const maintenance = [
  ['/home-health-check/', 'Home Health Check'],
  ['/home-maintenance-app/', 'Home maintenance app'],
  ['/home-maintenance-tracker/', 'Maintenance tracker'],
  ['/home-maintenance-records/', 'Maintenance & repair history'],
  ['/home-maintenance-reminders/', 'Maintenance reminders'],
  ['/home-maintenance-calendar/', 'Maintenance calendar'],
  ['/home-repair-cost-tracker/', 'Repair costs'],
  ['/annual-home-maintenance-checklist/', 'Free annual checklist'],
  ['/resources/', 'Homeowner guides']
];
const more = [
  ['/pricing/', 'Pricing & download'],
  ['/screenshots/', 'App screenshots'],
  ['/support/', 'Support'],
  ['/privacy/', 'Privacy'],
  ['/terms/', 'Terms'],
  ['/about/', 'About Quiet Tools'],
  ['/editorial-standards/', 'Editorial standards'],
  ['/homezada-alternative/', 'Compare with HomeZada']
];
---
<footer class="footer">
  {compact ? <div class="container"><p>© 2026 Around The House. Built and supported by the <a href="/about/">Quiet Tools Support Team</a> in Colorado, United States.</p></div> :
    <div class="container footer-grid">
      <div><a class="brand" href="/" aria-label="Around The House home"><img class="brand-mark" src="/assets/icons/around-the-house-icon.png" width="512" height="512" alt="" /><span>Around The House</span></a><p>Your home has a history. Keep it.</p><AppStoreLink /><p><a href="https://quiettoolsapps.com/">A Quiet Tools app</a><br />Colorado, United States<br />© 2026 Around The House.</p></div>
      <div><h2>Home records</h2>{records.map(([href, label]) => <a href={href}>{label}</a>)}</div>
      <div><h2>Maintenance &amp; guides</h2>{maintenance.map(([href, label]) => <a href={href}>{label}</a>)}</div>
      <div><h2>App &amp; support</h2>{more.map(([href, label]) => <a href={href}>{label}</a>)}<a href={`mailto:${supportEmail}`}>{supportEmail}</a></div>
    </div>
  }
</footer>
